{
  "manifest_version": 3,
  "name": "Lançador de Horas no Jira",
  "version": "1.0.0",
  "description": "Lança horas trabalhadas em tarefas do Jira sem abrir o Jira no navegador.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logo.jpg",
      "48": "logo.jpg",
      "128": "logo.jpg"
    }
  },
  "icons": {
    "16": "logo.jpg",
    "48": "logo.jpg",
    "128": "logo.jpg"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://desenv.betha.com.br/*"]
}
